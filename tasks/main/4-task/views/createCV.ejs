<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New CV</title>
</head>
<body>

    <h1>Create Your CV</h1>

    <form id="cvForm" enctype="multipart/form-data">

        <label>Full Name:</label>
        <input type="text" name="fullname" required>
        <br><br>

        <label>Contact Number:</label>
        <input type="text" name="contact">
        <br><br>

        <label>Email:</label>
        <input type="email" name="email">
        <br><br>

        <label>Profile Image:</label>
        <input type="file" name="image" accept="image/*">
        <br><br>

        <label>Qualifications (comma separated):</label>
        <textarea name="qualifications"></textarea>
        <br><br>

        <label>Certifications:</label>
        <textarea name="certifications"></textarea>
        <br><br>

        <label>Professional Experience:</label>
        <textarea name="experience"></textarea>
        <br><br>

        <label>Skills:</label>
        <textarea name="skills"></textarea>
        <br><br>

        <label>Languages:</label>
        <textarea name="languages"></textarea>
        <br><br>

        <label>Hobbies:</label>
        <textarea name="hobbies"></textarea>
        <br><br>

        <label>Research Statement:</label>
        <textarea name="researchStatement"></textarea>
        <br><br>

        <label>Summary:</label>
        <textarea name="summary"></textarea>
        <br><br>

        <label>Upload Documents:</label>
        <input type="file" name="documents" multiple>
        <br><br>

        <button type="submit">Save CV</button>

    </form>

    <br>
    <a href="/resumes">Back to Home</a>

    <script>
        document.getElementById("cvForm").addEventListener("submit", function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch("/resumes", { method: "POST", body: formData })
                .then(() => window.location.href = "/resumes")
                .catch(err => console.error(err));
        });
    </script>

</body>
</html>
