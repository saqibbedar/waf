<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV Management System</title>
</head>
<body>

    <h1>CV Management System</h1>

    <a href="/resumes/addNew"><button>Add New CV</button></a>

    <h2>All Resumes</h2>

    <% if (resumes.length === 0) { %>
        <p>No CV records found.</p>
    <% } %>

    <% resumes.forEach(resume => { %>

        <div style="border:1px solid black; padding:15px; margin:15px;">

            <h3><%= resume.fullname %></h3>
            <p>Email: <%= resume.email %></p>
            <p>Contact: <%= resume.contact %></p>

            <% if (resume.image) { %>
                <img src="/uploads/<%= resume.image %>" width="100" alt="Profile image">
            <% } %>

            <br><br>

            <a href="/resumes/<%= resume._id %>"><button>View</button></a>
            <a href="/resumes/<%= resume._id %>/edit"><button>Update</button></a>
            <button onclick="remove('<%= resume._id %>')">Delete</button>

        </div>

    <% }); %>

    <script>
        function remove(id) {
            fetch(`/resumes/${id}`, { method: "DELETE" })
                .then(() => window.location.reload())
                .catch(err => console.error(err));
        }
    </script>

</body>
</html>
