<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('partials/header') %>
    <h1>Homepage ...  </h1>
    <button onclick="showTable()">Show Information</button>
    <div id="tableContainer"></div>
    <script>
        function showTable(){

            document.getElementById("tableContainer").innerHTML = `
             <table border="1">
  <thead>
    <tr>
      <th>ID</th>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Email</th>
      <th>Gender</th>
      <th>IP Address</th>
    </tr>
  </thead>

  <tbody>
    <% users.map((user)=>{ %>
        <tr>
      <td><%= user.id %></td>
      <td><%= user.first_name %></td>
      <td><%= user.last_name %></td>
      <td><%= user.email %></td>
      <td><%= user.gender %></td>
      <td><%= user.ip_address %></td>
    </tr>

   <% }) %>
    
  </tbody>
</table>            

            `
        }
    </script>
   
<%- include('partials/footer') %>
</body>
</html>